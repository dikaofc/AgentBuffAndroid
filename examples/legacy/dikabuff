async function repl(cfg) {
  const rl = createInterface({ input: process.stdin, output: process.stdout });
  console.log(`${cmag("dikabuff")} ${cdim("v" + VERSION)} · model: ${cgreen(cfg.rawModel ?? (cfg.providerKey + "/" + cfg.cfg.model))} · config: ${cdim(cfg.path)}`);
  console.log("Ketik " + cdim("/help") + " untuk bantuan, " + cdim("/exit") + " untuk keluar.\n");
  const ask = () => rl.question(cmag("dikabuff> "), async ans => {
    const a = ans.trim();
    if (!a) return ask();
    if (a === "/exit" || a === "/quit") return rl.close();
    if (a === "/new") return ask();
    if (a === "/help") { printHelp(); return ask(); }
    if (a === "/config") { console.log(cdim(cfg.path) + "\n"); return ask(); }
    if (a.startsWith("/model ")) { cfg.cfg.model = a.slice(7).trim(); console.log(`model → ${cgreen(cfg.cfg.model)}\n`); return ask(); }
    rl.pause();
    try {
      const reply = await streamTurn(cfg.cfg, a);
      if (reply) console.log(`\n${cmag("[ringkasan]")} ${cdim(reply.slice(0, 400))}${reply.length > 400 ? cdim(" …") : ""}`);
    } catch (e) {
      console.log(`\n${cred("error:")} ${e.message}`);
    } finally {
      rl.resume();
      ask();
    }
  });
  rl.on("close", () => process.exit(0));
  ask();
}

async function doctor(cfg) {
  console.log(`config  : ${cfg.path}`);
  console.log(`provider: ${cfg.providerKey} (model: ${cfg.cfg.model})`);
  console.log(`endpoint: ${endpointFor(cfg.cfg.baseUrl)}`);
  console.log("mencoba koneksi…");

}

async function main(argv) {
  let configFlag = null, modelFlag = null, help = false, doc = false, prompt = null;
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--config" || a === "-c") configFlag = argv[++i];
    else if (a === "--model" || a === "-m") modelFlag = argv[++i];
    else if (a === "--help" || a === "-h") help = true;
    else if (a === "--doctor") doc = true;
    else if (a === "--version" || a === "-v") { console.log(VERSION); return; }
    else prompt = a;
  }
  if (help) { printHelp(); return; }

  const loaded = loadConfig(configFlag);
  if (loaded.created) {
    console.log(`config baru dibuat: ${loaded.path}`);
    console.log("Edit file itu (baseUrl/apiKey/model), lalu jalankan lagi. Contoh isi:");
    console.log(JSON.stringify(SAMPLE_CONFIG, null, 2));
    return;
  }
  if (doc) { doctor(loaded); return; }
  if (modelFlag) {
    const parts = String(modelFlag).split("/");
    loaded.cfg.model = parts.length > 1 ? parts.slice(1).join("/") : modelFlag;
    loaded.rawModel = modelFlag;
  }

  if (prompt) {
    if (wantStream) {
      await streamTurn(loaded.cfg, prompt);
    } else {
      const reply = await runAgent(loaded.cfg, prompt);
      console.log(`\n${cmag("dikabuff:")} ${reply}`);
    }
    return;
  }
  if (!process.stdin.isTTY) {
    const buf = fs.readFileSync(0, "utf8").trim();
    if (buf) {
      if (wantStream) await streamTurn(loaded.cfg, buf);
      else {
        const reply = await runAgent(loaded.cfg, buf);
        console.log(`\n${cmag("dikabuff:")} ${reply}`);
      }
    }
    return;
  }
  await repl(loaded);
}

main(process.argv.slice(2)).catch(e => {
  console.error(`\n${cred("error:")} ${e.message}`);
  process.exit(1);
});